[Unit]
Description=Ghostline encrypted DNS and DPI bypass
After=network.target NetworkManager.service systemd-resolved.service

[Service]
Type=simple
ExecStart=@DAEMON@ --daemon
ExecStopPost=@DAEMON@ --restore
Restart=on-failure
RestartSec=2
StateDirectory=ghostline
StateDirectoryMode=0755
LogsDirectory=ghostline
RuntimeDirectory=ghostline
RuntimeDirectoryMode=0755
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE CAP_SETUID CAP_SETGID CAP_KILL CAP_DAC_OVERRIDE CAP_CHOWN CAP_FOWNER

[Install]
WantedBy=multi-user.target
