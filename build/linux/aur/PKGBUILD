# Maintainer: Harry Nguyen <duchanhstyle@gmail.com>
# Rendered by build/linux/aur/render.sh: @…@ values are filled at release.
pkgname=ghostline-bin
pkgver=@PKGVER@
_ver=@VERSION@
pkgrel=1
pkgdesc="Encrypted DNS and protection against DPI interference, with a background service"
arch=('x86_64')
url="https://github.com/hashcott/ghostline"
license=('GPL-3.0-only')
depends=('gtk4' 'webkitgtk-6.0')
optdepends=('nss: Fake SNI in Chrome and Chromium (certutil)')
provides=('ghostline')
conflicts=('ghostline')
install=ghostline.install
options=('!strip' '!debug')
source=("@SOURCE@")
sha256sums=('@SHA256@')

package() {
	cd "ghostline-${_ver}-linux-amd64"
	install -Dm755 ghostline "$pkgdir/usr/bin/ghostline"
	install -Dm755 ghostlined "$pkgdir/usr/lib/ghostline/ghostlined"
	install -Dm644 packaging/ghostline.service "$pkgdir/usr/lib/systemd/system/ghostline.service"
	install -Dm644 packaging/ghostline-sysusers.conf "$pkgdir/usr/lib/sysusers.d/ghostline.conf"
	install -Dm644 ghostline.desktop "$pkgdir/usr/share/applications/ghostline.desktop"
	install -Dm644 ghostline.png "$pkgdir/usr/share/icons/hicolor/512x512/apps/ghostline.png"
	install -Dm644 io.github.hashcott.ghostline.metainfo.xml "$pkgdir/usr/share/metainfo/io.github.hashcott.ghostline.metainfo.xml"
	install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
	install -Dm644 NOTICE "$pkgdir/usr/share/licenses/$pkgname/NOTICE"
}
